# ==========================================
# StudyBuddy - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets to Git.

# Application Environment
VITE_APP_NAME=StudyBuddy
VITE_APP_VERSION=2.0.0
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_in_production

# ------------------------------------------
# Amazon Web Services (AWS) S3 Configuration
# ------------------------------------------
# StudyBuddy uses Amazon S3 to store uploaded notes (PDF, DOCX, PPTX, JPG, PNG).
# Note: AWS credentials should be kept secure on server-side or configured via IAM roles.

# AWS Region where your S3 bucket resides (e.g., eu-north-1, us-east-1, ap-south-1)
AWS_REGION=eu-north-1

# Amazon S3 Bucket Name
AWS_S3_BUCKET=studybuddy-notes-vault
AWS_S3_BUCKET_NAME=studybuddy-notes-vault

# AWS IAM User Access Key ID (Must have s3:PutObject, s3:GetObject, s3:ListBucket, s3:DeleteObject permissions)
AWS_ACCESS_KEY_ID=your_access_key_id

# AWS IAM User Secret Access Key
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Custom Endpoint (Optional - leave empty for standard AWS S3, or specify for LocalStack / MinIO / S3-compatible endpoints)
# AWS_S3_CUSTOM_ENDPOINT=http://localhost:4566

# Storage Mode: "aws" (or "s3") for live AWS S3, or "emulated" for local offline storage sandbox
STORAGE_MODE=aws

# ------------------------------------------
# AI Engine Configuration (Optional)
# ------------------------------------------
# StudyBuddy includes an intelligent pedagogical analysis engine out-of-the-box.
# You can also connect OpenAI or Google Gemini if desired:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
